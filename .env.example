# ============================================================
# Testing and Evaluation Agent
# Environment variable template
# ============================================================
#
# Copy this file to ".env" for local development.
# Never commit the real ".env" file.
#
# Do not place production credentials in this file.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=Testing and Evaluation Agent
APP_ENV=development
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Microsoft Agent Framework and Microsoft Foundry
# ------------------------------------------------------------
#
# Supported authentication modes:
#   azure_cli
#   api_key
#
# Prefer Azure CLI authentication for local development.
# Run "az login" before starting the application when using
# the azure_cli authentication mode.
# ------------------------------------------------------------

MAF_AUTH_MODE=azure_cli

# Example:
# https://your-project.services.ai.azure.com
MAF_PROJECT_ENDPOINT=

# Use the deployment name configured in the Foundry project.
MAF_MODEL_NAME=

# Only required when MAF_AUTH_MODE=api_key.
MAF_MODEL_API_KEY=


# ------------------------------------------------------------
# Agent behavior
# ------------------------------------------------------------

AGENT_NAME=TestingEvaluationAgent

# Generation randomness.
# Keep low for repeatable test cases and scripts.
AGENT_TEMPERATURE=0.1

# Maximum number of automatic workflow transitions allowed
# during one run.
AGENT_MAX_WORKFLOW_STEPS=20


# ------------------------------------------------------------
# Human approval controls
# ------------------------------------------------------------

REQUIRE_TEST_CASE_APPROVAL=true
REQUIRE_SCRIPT_APPROVAL=true
REQUIRE_EVALUATION_APPROVAL=true
ALLOW_LIVE_TEST_EXECUTION=false
ALLOW_DESTRUCTIVE_TESTS=false


# ------------------------------------------------------------
# Repository paths
# ------------------------------------------------------------

SKILLS_DIR=skills
GENERATED_SPECS_DIR=specs/generated
APPROVED_SPECS_DIR=specs/approved
GENERATED_TESTS_DIR=tests/generated
REPORTS_DIR=reports
TRACES_DIR=traces
SCREENSHOTS_DIR=screenshots

EVAL_DATASETS_DIR=evals/datasets
EVAL_RUBRICS_DIR=evals/rubrics
EVAL_BASELINES_DIR=evals/baselines
EVAL_RESULTS_DIR=evals/results


# ------------------------------------------------------------
# Playwright Test
# ------------------------------------------------------------
#
# TARGET_BASE_URL should point only to an approved test
# environment. Production testing is disabled by default.
# ------------------------------------------------------------

TARGET_BASE_URL=http://localhost:3000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_EXPECT_TIMEOUT_MS=5000
PLAYWRIGHT_RETRIES=0
PLAYWRIGHT_WORKERS=1


# ------------------------------------------------------------
# Playwright MCP
# ------------------------------------------------------------
#
# MCP integration is disabled until the MCP adapter is
# implemented and explicitly enabled.
# ------------------------------------------------------------

PLAYWRIGHT_MCP_ENABLED=false
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=@playwright/mcp@latest
PLAYWRIGHT_MCP_URL=


# ------------------------------------------------------------
# GitHub MCP (read-only repository evidence)
# ------------------------------------------------------------
#
# The hosted GitHub MCP endpoint needs no Docker or WSL installation.
# The standalone Python CLI uses a fine-grained read-only token until
# OAuth support is added. Never commit the token.
# Grant only Metadata, Contents, Pull requests, and Issues as needed.
#
GITHUB_MCP_ENABLED=false
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
GITHUB_MCP_TOKEN=
GITHUB_MCP_ALLOW_PRIVATE_REPOSITORIES=false
GITHUB_MCP_TIMEOUT_SECONDS=30

# Optional local GitHub MCP server settings. Leave blank unless explicitly
# using a separately managed stdio server.
GITHUB_MCP_COMMAND=
GITHUB_MCP_ARGS=


# ------------------------------------------------------------
# Azure DevOps MCP
# ------------------------------------------------------------
#
# ADO MCP is reserved for a future project version.
# ------------------------------------------------------------

ADO_MCP_ENABLED=false
ADO_MCP_URL=


# ------------------------------------------------------------
# Reporting and artifact retention
# ------------------------------------------------------------

SAVE_SCREENSHOTS_ON_FAILURE=true
SAVE_TRACE_ON_FAILURE=true
SAVE_VIDEO_ON_FAILURE=false
REPORT_FORMAT=json